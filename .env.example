# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="change-me"

# LLM text cleanup
# Providers: gemini or openai_compatible
LLM_PROVIDER=gemini
LLM_API_KEY="change-me"
LLM_MODEL=gemini-2.5-flash
# Gemini can leave LLM_BASE_URL empty.
# For an OpenAI-compatible service, use a URL such as http://127.0.0.1:1234/v1
LLM_BASE_URL=

# Audio input
WAV_DIR=wav_24hr

# Optional: use an existing whisper.cpp installation instead of auto-setup
# WHISPER_CLI_PATH=/absolute/path/to/whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.bin
